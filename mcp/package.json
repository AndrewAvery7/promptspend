{
  "name": "@promptspend/mcp",
  "version": "0.1.2",
  "description": "LLM pricing for coding agents — every price carries its source and the date it was confirmed.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "promptspend-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AndrewAvery7/promptspend.git",
    "directory": "mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "pricing",
    "cost",
    "claude",
    "cursor"
  ],
  "scripts": {
    "build": "tsx tools/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:footprint": "tsx tools/check-footprint.ts",
    "verify": "npm run typecheck && npm run test && npm run check:footprint && npm run build && npm run check:startup",
    "check:startup": "tsx tools/check-startup.ts",
    "prepublishOnly": "npm run verify",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=20"
  }
}
