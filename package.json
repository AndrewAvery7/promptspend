{
  "name": "promptspend",
  "version": "0.5.0",
  "private": false,
  "description": "Estimate, compare and understand LLM API costs — with pricing that syncs itself daily.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://promptspend.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/AndrewAvery7/promptspend.git"
  },
  "keywords": [
    "llm",
    "tokens",
    "pricing",
    "cost-estimator",
    "openai",
    "anthropic",
    "deepseek",
    "ai-costs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:pages",
    "build:pages": "tsx scripts/build-pages.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:catalog": "tsx scripts/validate-catalog.ts",
    "check:budget": "tsx scripts/check-bundle-budget.ts",
    "check:test-badge": "tsx scripts/check-test-badge.ts",
    "check:csp": "tsx scripts/check-csp.ts",
    "check:encoding": "tsx scripts/check-encoding.ts",
    "ping:indexnow": "tsx scripts/ping-indexnow.ts",
    "ping:indexnow:dry": "tsx scripts/ping-indexnow.ts --dry-run",
    "sync:pricing": "tsx scripts/sync-pricing.ts",
    "sync:pricing:dry": "tsx scripts/sync-pricing.ts --dry-run",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run check:encoding && npm run test:coverage && npm run check:test-badge && npm run build && npm run validate:catalog && npm run check:budget && npm run check:csp && npm run check:seo",
    "check:seo": "tsx scripts/check-seo.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "js-tiktoken": "^1.0.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true
  }
}
