{
  "expo": {
    "name": "PromptSpend",
    "slug": "promptspend-app",
    "description": "Estimate, compare, and understand LLM API costs with pricing provenance and freshness evidence.",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "promptspend",
    "userInterfaceStyle": "automatic",
    "githubUrl": "https://github.com/AndrewAvery7/promptspend",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.promptspend.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.promptspend.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#2456E6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2456E6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 104,
          "dark": {
            "backgroundColor": "#0B0E14",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "IBM Plex Sans",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/ibm-plex-sans-400.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/ibm-plex-sans-600.ttf",
                    "weight": 600
                  }
                ]
              },
              {
                "fontFamily": "Space Grotesk",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/space-grotesk-500.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/space-grotesk-700.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "JetBrains Mono",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/jetbrains-mono-400.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/jetbrains-mono-700.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/ibm-plex-sans-400.ttf",
              "./assets/fonts/ibm-plex-sans-600.ttf",
              "./assets/fonts/space-grotesk-500.ttf",
              "./assets/fonts/space-grotesk-700.ttf",
              "./assets/fonts/jetbrains-mono-400.ttf",
              "./assets/fonts/jetbrains-mono-700.ttf"
            ]
          }
        }
      ],
      "expo-web-browser",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9671ef3e-be90-49ba-aebe-56b6982af806"
      }
    },
    "owner": "crestwood-holdings"
  }
}
