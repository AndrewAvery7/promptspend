      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_ALERTS_API": "https://api.promptspend.dev"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
