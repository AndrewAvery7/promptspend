{
  "$comment": "Family-level capture rules. Patterns are deliberately version-agnostic so a newly released model is picked up by the next daily sync without a code change — it arrives flagged for review rather than published silently.",
  "providers": [
    {
      "id": "anthropic",
      "name": "Anthropic",
      "country": "US",
      "pricingUrl": "https://platform.claude.com/docs/en/about-claude/pricing"
    },
    {
      "id": "openai",
      "name": "OpenAI",
      "country": "US",
      "pricingUrl": "https://developers.openai.com/api/docs/pricing"
    },
    {
      "id": "google",
      "name": "Google",
      "country": "US",
      "pricingUrl": "https://ai.google.dev/gemini-api/docs/pricing"
    },
    {
      "id": "deepseek",
      "name": "DeepSeek",
      "country": "CN",
      "pricingUrl": "https://api-docs.deepseek.com/quick_start/pricing"
    },
    {
      "id": "moonshot",
      "name": "Moonshot AI",
      "country": "CN",
      "pricingUrl": "https://platform.kimi.ai/docs/pricing/chat"
    },
    {
      "id": "alibaba",
      "name": "Alibaba (Qwen)",
      "country": "CN",
      "pricingUrl": "https://www.alibabacloud.com/help/en/model-studio/models"
    },
    {
      "id": "zai",
      "name": "Z.ai (GLM)",
      "country": "CN",
      "pricingUrl": "https://docs.z.ai/guides/overview/pricing"
    },
    {
      "id": "minimax",
      "name": "MiniMax",
      "country": "CN",
      "pricingUrl": "https://platform.minimax.io/docs/guides/pricing-paygo"
    },
    { "id": "xai", "name": "xAI", "country": "US", "pricingUrl": "https://docs.x.ai/developers/pricing" },
    { "id": "mistral", "name": "Mistral AI", "country": "FR", "pricingUrl": "https://mistral.ai/pricing" },
    { "id": "cohere", "name": "Cohere", "country": "CA", "pricingUrl": "https://cohere.com/pricing" },
    {
      "id": "amazon",
      "name": "Amazon",
      "country": "US",
      "pricingUrl": "https://aws.amazon.com/bedrock/pricing/"
    },
    {
      "id": "meta",
      "name": "Meta",
      "country": "US",
      "pricingUrl": "https://dev.meta.ai/docs/pricing-rate-limits"
    },
    {
      "id": "xiaomi",
      "name": "Xiaomi (MiMo)",
      "country": "CN",
      "pricingUrl": "https://mimo.mi.com/docs/en-US/price/pay-as-you-go"
    },
    {
      "id": "inception",
      "name": "Inception",
      "country": "US",
      "pricingUrl": "https://docs.inceptionlabs.ai/get-started/models"
    },
    {
      "id": "microsoft",
      "name": "Microsoft",
      "country": "US",
      "pricingUrl": "https://azure.microsoft.com/en-us/pricing/details/ai-foundry-models/microsoft/"
    }
  ],
  "globalExclude": [
    "\\d{8}$",
    "-latest$",
    "chat-latest",
    "search-api",
    ":free$",
    "-lightning$",
    "-live-",
    "customtools",
    "@"
  ],
  "families": [
    {
      "id": "anthropic-claude",
      "providerId": "anthropic",
      "include": ["^claude-(fable|opus|sonnet|haiku)-\\d+(-\\d+)?$"],
      "tokenizer": {
        "kind": "approx",
        "charsPerToken": 3.6,
        "cjkCharsPerToken": 1.5,
        "note": "Estimate — Anthropic's tokenizer is server-side; ratio calibrated on English prose"
      },
      "capabilities": { "reasoning": true, "vision": true }
    },
    {
      "id": "openai-gpt",
      "providerId": "openai",
      "include": [
        "^gpt-(5|6)(\\.\\d+)?(-mini|-nano|-terra|-luna|-sol|-astra|-pro)?$",
        "^o\\d+(-mini|-pro)?$"
      ],
      "tokenizer": { "kind": "tiktoken", "encoding": "o200k_base" },
      "capabilities": { "reasoning": true, "vision": true }
    },
    {
      "id": "openai-gpt-4",
      "providerId": "openai",
      "include": ["^gpt-4\\.1(-mini)?$", "^gpt-4o(-mini)?$"],
      "tokenizer": { "kind": "tiktoken", "encoding": "o200k_base" },
      "capabilities": { "reasoning": false, "vision": true }
    },
    {
      "id": "google-gemini",
      "providerId": "google",
      "include": [
        "^gemini/gemini-3(\\.\\d+)?-(pro|flash)(-lite)?(-preview)?$",
        "^gemini/gemini-2\\.5-(pro|flash)(-lite)?$",
        "^gemini/gemini-4-[a-z]+$"
      ],
      "stripPrefix": "gemini/",
      "tokenizer": {
        "kind": "approx",
        "charsPerToken": 4.0,
        "cjkCharsPerToken": 1.6,
        "note": "Estimate — Gemini's tokenizer is server-side"
      },
      "capabilities": { "reasoning": true, "vision": true }
    },
    {
      "id": "deepseek",
      "providerId": "deepseek",
      "include": ["^deepseek/deepseek-(v\\d+(\\.\\d+)?(-pro|-flash)?|r\\d+)$"],
      "stripPrefix": "deepseek/",
      "tokenizer": {
        "kind": "approx",
        "charsPerToken": 3.4,
        "cjkCharsPerToken": 1.7,
        "note": "Estimate — DeepSeek's tokenizer handles Chinese far more densely than English"
      },
      "capabilities": { "reasoning": true, "vision": false }
    },
    {
      "id": "moonshot-kimi",
      "providerId": "moonshot",
      "include": ["^moonshot/kimi-k[\\d.]+(-thinking|-pro|-code)?$"],
      "stripPrefix": "moonshot/",
      "tokenizer": {
        "kind": "approx",
        "charsPerToken": 3.4,
        "cjkCharsPerToken": 1.6,
        "note": "Estimate — Moonshot tokenizer, calibrated for mixed English/Chinese"
      },
      "capabilities": { "reasoning": true, "vision": true }
    },
    {
      "id": "alibaba-qwen",
      "providerId": "alibaba",
      "include": [
        "^dashscope/qwen3\\.\\d+-(max|plus|flash|omni-flash)$",
        "^dashscope/qwen3-next-80b-a3b-(instruct|thinking)$",
        "^dashscope/qwen3-vl-235b-a22b-instruct$"
      ],
      "stripPrefix": "dashscope/",
      "tokenizer": {
        "kind": "approx",
        "charsPerToken": 3.5,
        "cjkCharsPerToken": 1.5,
        "note": "Estimate — Qwen tokenizer, calibrated for mixed English/Chinese"
      },
      "capabilities": { "reasoning": true, "vision": false }
    },
    {
      "id": "zai-glm",
      "providerId": "zai",
      "include": [
        "^zai/glm-(5(\\.\\d+)?|4\\.[67])(-code)?$",
        "^zai/glm-5\\.3-flash$",
        "^zai/glm-4\\.5(-x|-air|-airx)?$",
        "^zai/glm-4-32b-0414-128k$"
      ],
      "stripPrefix": "zai/",
      "tokenizer": {
        "kind": "approx",
        "charsPerToken": 3.5,
        "cjkCharsPerToken": 1.6,
        "note": "Estimate — GLM tokenizer, calibrated for mixed English/Chinese"
      },
      "capabilities": { "reasoning": true, "vision": false }
    },
    {
      "id": "minimax",
      "providerId": "minimax",
      "include": ["^minimax/MiniMax-M\\d+(\\.\\d+)?$"],
      "stripPrefix": "minimax/",
      "tokenizer": {
        "kind": "approx",
        "charsPerToken": 3.5,
        "cjkCharsPerToken": 1.6,
        "note": "Estimate — MiniMax tokenizer"
      },
      "capabilities": { "reasoning": true, "vision": false }
    },
    {
      "id": "xai-grok",
      "providerId": "xai",
      "include": [
        "^xai/grok-\\d+(\\.\\d+)?$",
        "^xai/grok-\\d+(-\\d+)?-fast$",
        "^xai/grok-build-\\d+(\\.\\d+)?$"
      ],
      "stripPrefix": "xai/",
      "tokenizer": {
        "kind": "approx",
        "charsPerToken": 3.7,
        "cjkCharsPerToken": 1.6,
        "note": "Estimate — Grok tokenizer"
      },
      "capabilities": { "reasoning": true, "vision": true }
    },
    {
      "id": "mistral",
      "providerId": "mistral",
      "include": ["^mistral/mistral-(large|medium)-\\d(\\.\\d|-\\d)?$", "^mistral/codestral-\\d{4}$"],
      "stripPrefix": "mistral/",
      "tokenizer": {
        "kind": "approx",
        "charsPerToken": 3.7,
        "cjkCharsPerToken": 1.8,
        "note": "Estimate — Mistral tokenizer"
      },
      "capabilities": { "reasoning": false, "vision": true }
    },
    {
      "id": "cohere-command",
      "providerId": "cohere",
      "include": ["^command-a-\\d{2}-\\d{4}$", "^command-r(-plus)?-\\d{2}-\\d{4}$"],
      "tokenizer": {
        "kind": "approx",
        "charsPerToken": 3.8,
        "cjkCharsPerToken": 1.8,
        "note": "Estimate — Cohere tokenizer"
      },
      "capabilities": { "reasoning": false, "vision": false }
    },
    {
      "id": "amazon-nova",
      "providerId": "amazon",
      "include": ["^amazon\\.nova-2-(pro|lite)", "^amazon\\.nova-(micro|lite|pro)-v1:0$"],
      "stripPrefix": "amazon.",
      "tokenizer": {
        "kind": "approx",
        "charsPerToken": 3.8,
        "cjkCharsPerToken": 1.7,
        "note": "Estimate — Nova tokenizer"
      },
      "capabilities": { "reasoning": true, "vision": true }
    },
    {
      "id": "meta-muse",
      "providerId": "meta",
      "include": ["^meta/muse-(spark|wonder)-\\d+(\\.\\d+)?$"],
      "exclude": ["^meta/muse-spark-1\\.[12]$"],
      "stripPrefix": "meta/",
      "tokenizer": {
        "kind": "approx",
        "charsPerToken": 3.8,
        "cjkCharsPerToken": 1.7,
        "note": "Estimate — Muse tokenizer; Meta publishes no ratio"
      },
      "capabilities": { "reasoning": true, "vision": true }
    },
    {
      "id": "xiaomi-mimo",
      "providerId": "xiaomi",
      "include": ["^xiaomi_mimo/mimo-v\\d+(\\.\\d+)?-(pro|flash)$"],
      "stripPrefix": "xiaomi_mimo/",
      "tokenizer": {
        "kind": "approx",
        "charsPerToken": 3.5,
        "cjkCharsPerToken": 1.5,
        "note": "Estimate — MiMo tokenizer, calibrated for mixed English/Chinese"
      },
      "capabilities": { "reasoning": true, "vision": true }
    },
    {
      "id": "inception-mercury",
      "providerId": "inception",
      "include": ["^inception/mercury-\\d+(\\.\\d+)?$"],
      "stripPrefix": "inception/",
      "tokenizer": {
        "kind": "approx",
        "charsPerToken": 3.8,
        "cjkCharsPerToken": 1.7,
        "note": "Estimate — Mercury tokenizer; Inception publishes no ratio"
      },
      "capabilities": { "reasoning": true, "vision": false }
    },
    {
      "id": "microsoft-mai",
      "providerId": "microsoft",
      "include": ["^azure_ai/MAI-Thinking-\\d+$"],
      "stripPrefix": "azure_ai/",
      "tokenizer": {
        "kind": "approx",
        "charsPerToken": 3.8,
        "cjkCharsPerToken": 1.7,
        "note": "Estimate — MAI tokenizer; Microsoft publishes no ratio"
      },
      "capabilities": { "reasoning": true, "vision": false }
    }
  ]
}
