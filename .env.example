# Copy to .env.local for local development. .env.local is git-ignored.
#
# Origin of the price-alerts API (the `worker/` project). This single value
# feeds both the client and the generated Content Security Policy, so setting it
# here is all that is needed to point a local build at a deployed worker.
#
# Leave it unset to build the site with alerts switched off, which is the
# default and what the test suite exercises.
#
# In CI this comes from the repository variable ALERTS_API — see
# .github/workflows/verify.yml and docs/ALERTS.md.
VITE_ALERTS_API=https://token-tally-alerts.crestwood.workers.dev
