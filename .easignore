# Keep this base section aligned with .gitignore. EAS prioritizes this file.
node_modules/
dist/
coverage/
*.local
.DS_Store
.env
.env.*
!.env.example
.vite/

test-results
playwright-report
blob-report
.playwright

assets/promo-frames/*
!assets/promo-frames/04-editor.png
!assets/promo-frames/04-status.png
assets/core.mp4
assets/*-promo.mp4
assets/.bed-looped.mp3
.promo-fonts/
assets/hero.mp4
assets/endcard.mp4
mcp/dist/
.claude/
tools/__pycache__/

# Local verification output and private traffic exports must never enter an
# EAS upload archive. The traffic export is user-owned and unrelated to mobile.
.verification/
apps/mobile/.verification/
apps/mobile/dist-verification/
referrers-*.json
apps/mobile/.expo/
apps/mobile/.kotlin/
apps/mobile/android/
apps/mobile/ios/
apps/mobile/expo-env.d.ts
*.jks
*.p8
*.p12
*.pem
*.key
*.mobileprovision
credentials.json
google-services.json
GoogleService-Info.plist

# The build needs apps/mobile and packages/core. These repository surfaces are
# not build inputs and only increase archive size and disclosure surface.
# `apps/mobile/scripts/check-release.mjs` is intentionally a host/CI preflight:
# it verifies several excluded docs and public policy files before EAS archives
# this reduced tree. Do not wire that script as an EAS build hook unless those
# evidence paths are first supplied as a separate verified artifact.
/.github/
/api/
/assets/
/data/
/design-system/
/docs/
/mcp/
/public/
/scripts/
/src/
/tests/
/tools/
/vscode/
/worker/
