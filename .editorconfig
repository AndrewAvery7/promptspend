root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Matches .prettierrc.json, which is the authority for everything it touches.
[*.{ts,tsx,js,jsx,css,json,jsonc,yml,yaml,html}]
max_line_length = 110

[*.py]
indent_size = 4
max_line_length = 100

# Prettier preserves hard line breaks in markdown, and several tables here rely
# on trailing alignment.
[*.md]
trim_trailing_whitespace = false

[*.{png,jpg,woff,woff2,ico,pdf}]
trim_trailing_whitespace = false
insert_final_newline = false

# Generated by the sync pipeline; never hand-edit, never reformat.
[public/data/*.json]
insert_final_newline = true
trim_trailing_whitespace = true
