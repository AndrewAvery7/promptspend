{
  "name": "promptspend-updates",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted over-the-air update server for the PromptSpend app (Expo Updates protocol v1), on Cloudflare Workers.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "typescript": "^5.7.2",
    "vitest": "^5.0.2",
    "wrangler": "^4.118.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260801.1": true
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
