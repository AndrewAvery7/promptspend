{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promptspend-alerts",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // The API lives on .dev; the app lives on .com. Keeping them apart means the
  // marketing domain never carries API traffic or its CORS surface.
  "routes": [{ "pattern": "api.promptspend.dev", "custom_domain": true }],

  // Every value below that mentions a hostname is part of the domain cutover.
  // `docs/ALERTS.md` lists them in one place; nothing else needs editing when
  // the custom domain arrives.
  "vars": {
    // Where the browser app is served from. Confirmation and unsubscribe links
    // land back here, and it is the default CORS origin.
    "SITE_ORIGIN": "https://promptspend.com",
    "SITE_BASE_PATH": "/",
    "ALERTS_API_ORIGIN": "https://api.promptspend.dev",
    // Comma-separated. Only these origins may call the API from a browser.
    // github.io stays listed through the cutover: the site is still served from
    // there until SITE_URL flips, and an origin that disappears mid-move breaks
    // every alerts call with a CORS error that looks like an outage.
    "ALLOWED_ORIGINS": "https://promptspend.com,https://www.promptspend.com,https://andrewavery7.github.io",
    // Set to "cloudflare" ahead of the API token existing, which is safe:
    // `emailEnabled()` requires BOTH the transport and EMAIL_API_TOKEN, so
    // until the secret is stored the API reports email as unavailable and the
    // UI says so rather than accepting a subscription it cannot deliver.
    // Storing the secret and redeploying is then the only remaining step.
    "EMAIL_TRANSPORT": "cloudflare",
    "EMAIL_FROM": "alerts@promptspend.com",
    "EMAIL_FROM_NAME": "PromptSpend",
    "EMAIL_REPLY_TO": "",
    "CLOUDFLARE_ACCOUNT_ID": "e2e63d45dcb042990aea10d4d55260fd",
    // RFC 8292 requires a contact the push service can reach if our traffic
    // misbehaves. Must be a mailto: or https: URL.
    "VAPID_SUBJECT": "https://github.com/AndrewAvery7/promptspend",
    // Bot protection on the subscribe endpoints. Optional in development;
    // `TURNSTILE_SECRET_KEY` being set is what turns enforcement on.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEElIZdoZcZpxAjz",
    "TURNSTILE_HOSTNAMES": "api.promptspend.dev,promptspend.com,www.promptspend.com,andrewavery7.github.io",
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "promptspend-alerts",
      "database_id": "5b28b2b1-1b5e-4209-a771-e5ec24ca32b1",
      "migrations_dir": "migrations",
    },
  ],

  // No KV binding. There was one, and nothing ever read it — an unused binding
  // is a claim about what this Worker can touch, and that claim should be true.
  // The public pricing API on promptspend.dev will want a cache; it can have its
  // own namespace then, rather than inheriting an empty one from here.

  // Weekly digest. Monday 14:00 UTC is mid-morning in the US and late afternoon
  // in Europe — the compromise that puts it in a working day for most readers.
  "triggers": { "crons": ["0 14 * * 1"] },
}
