{
  // Worker source and its tests. Deliberately has no Node types: this code runs
  // on workerd, and reaching for `process`, `Buffer` or `node:fs` here should be
  // a compile error rather than something discovered in production. The tooling
  // under scripts/ genuinely is Node and is checked by tsconfig.scripts.json.
  //
  // This split was not cosmetic. With one config covering both, the Node script
  // typechecked locally only because TypeScript walked up and found the *site's*
  // @types/node in the parent directory — which CI, installing only this
  // package, does not have. It passed here and failed there.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Runtime types come from `wrangler types`, which generates
    // worker-configuration.d.ts from wrangler.jsonc and supersedes
    // @cloudflare/workers-types. `npm run typecheck` regenerates it first, so
    // the types can never describe a binding set the config no longer has.
    "types": ["vitest/globals"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts", "worker-configuration.d.ts"]
}
